/*
 * =============================================================================
 * Nextflow AWS Batch Configuration — scRNA-seq + VDJ Pipeline
 * =============================================================================
 *
 * Usage:
 *   nextflow run python_pipeline.nf -c nextflow.aws.config [options]
 *
 * Requires:
 *   - AWS Batch compute environments and queues (see aws/setup_batch.sh)
 *   - Docker images pushed to ECR (see aws/push_images.sh)
 *   - Data uploaded to s3://kstme-scrna/
 */

// ---------------------------------------------------------------------------
// Parameters
// ---------------------------------------------------------------------------
params {
    // Docker images (update {account_id} and {region} after ECR setup)
    cpu_image  = '{account_id}.dkr.ecr.us-east-1.amazonaws.com/scrna-cpu:latest'
    gpu_image  = '{account_id}.dkr.ecr.us-east-1.amazonaws.com/scrna-gpu:latest'

    // S3 paths
    results             = 's3://kstme-scrna/results'
    metadata            = 's3://kstme-scrna/config/kstme_sc_metadata.csv'
    clinical_metadata   = 's3://kstme-scrna/config/KSTME_updated_clinical_metadata.csv'
    config              = 's3://kstme-scrna/config/config_batch.yaml'
    fastq_base          = 's3://kstme-scrna/fastq'

    // Reference genomes (baked into the CPU Docker image)
    gex_ref  = '/opt/references/refdata-gex-GRCh38-2024-A'
    vdj_ref  = '/opt/references/refdata-cellranger-vdj-GRCh38'

    // Analysis arm
    arm = 'primary'
}

// ---------------------------------------------------------------------------
// Process configuration
// ---------------------------------------------------------------------------
process {
    executor = 'awsbatch'
    queue    = 'scrna-cpu-queue'

    // Retry on Spot interruptions
    maxRetries    = 3
    errorStrategy = { task.exitStatus in [137, 143, 250] ? 'retry' : 'finish' }

    withLabel: high_mem_cpu {
        queue   = 'scrna-cpu-queue'
        cpus    = 12
        memory  = 250.GB
        time    = '6h'
    }

    withLabel: low_mem_cpu {
        queue   = 'scrna-cpu-queue'
        cpus    = 4
        memory  = 16.GB
        time    = '2h'
    }

    withLabel: mid_mem_cpu {
        queue   = 'scrna-cpu-queue'
        cpus    = 8
        memory  = 64.GB
        time    = '4h'
    }

    withLabel: gpu {
        queue       = 'scrna-gpu-queue'
        cpus        = 4
        memory      = 16.GB
        time        = '2h'
        accelerator 1, type: 'nvidia-tesla-t4'
    }

    withLabel: gpu_large {
        queue       = 'scrna-gpu-queue'
        cpus        = 8
        memory      = 32.GB
        time        = '4h'
        accelerator 1, type: 'nvidia-tesla-a10g'
    }
}

// ---------------------------------------------------------------------------
// AWS configuration
// ---------------------------------------------------------------------------
aws {
    region = 'us-east-1'
    batch {
        cliPath              = '/usr/local/bin/aws'
        maxParallelTransfers = 10
        maxTransferAttempts  = 3
    }
}

// ---------------------------------------------------------------------------
// Nextflow work directory (S3)
// ---------------------------------------------------------------------------
workDir = 's3://kstme-scrna/nextflow-work'

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
report {
    enabled = true
    file    = 'reports/execution_report.html'
}

timeline {
    enabled = true
    file    = 'reports/timeline.html'
}

trace {
    enabled = true
    file    = 'reports/trace.txt'
    fields  = 'task_id,hash,name,status,exit,realtime,cpus,memory,%cpu,%mem,rss,peak_rss'
}
